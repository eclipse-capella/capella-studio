<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  
  <artifactId>org.polarsys.capella.studio.releng.product</artifactId>
  <packaging>eclipse-repository</packaging>
  
  <name>Capella studio Product</name>
  
  <parent>
    <groupId>org.polarsys.capella</groupId>
    <artifactId>org.polarsys.capella.studio</artifactId>
    <version>7.2.0-SNAPSHOT</version>
    <relativePath>../org.polarsys.capella.studio.releng.parent</relativePath>
  </parent>
  
  <build>
	<plugins>
		<plugin>
			<groupId>org.eclipse.tycho</groupId>
			<artifactId>tycho-p2-director-plugin</artifactId>
			<version>${tycho-version}</version>
			<executions>
				<execution>
					<id>materialize-products</id>
					<goals>
						<goal>materialize-products</goal>
					</goals>
				</execution>
				<execution>
					<phase>integration-test</phase>
					<id>archive-products</id>
					<goals>
						<goal>archive-products</goal>
					</goals>
				</execution>
			</executions>
			<configuration>
				<profile>SDKProfile</profile>
				<products>
					<product>
						<id>org.polarsys.capella.studio.releng.product</id>
						<archiveFileName>capella-studio-${calversion}.${buildQualifier}</archiveFileName>
						<rootFolders>
								<macosx>Capella-Studio.app</macosx>
							</rootFolders>
					</product>
				</products>
			</configuration>
		</plugin>
			<plugin>
				<!-- Copy ziped component in zips -->
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>create-dropin-folders</id>
						<phase>package</phase>
						<configuration>
							<target>
								<echo>Create dropin folders in porducts</echo>
								<touch mkdirs="true" file="${basedir}/target/products/org.polarsys.capella.studio.releng.product/linux/gtk/x86_64/dropins/.empty"/>
								<touch mkdirs="true" file="${basedir}/target/products/org.polarsys.capella.studio.releng.product/linux/gtk/aarch64/dropins/.empty"/>
								<touch mkdirs="true" file="${basedir}/target/products/org.polarsys.capella.studio.releng.product/macosx/cocoa/x86_64/Capella-Studio.app/Contents/Eclipse/dropins/.empty"/>
								<touch mkdirs="true" file="${basedir}/target/products/org.polarsys.capella.studio.releng.product/macosx/cocoa/aarch64/Capella-Studio.app/Contents/Eclipse/dropins/.empty"/>
								<touch mkdirs="true" file="${basedir}/target/products/org.polarsys.capella.studio.releng.product/win32/win32/x86_64/dropins/.empty"/>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
	  </plugins>
	</build>
	<profiles>
		<profile>
			<id>sign</id>
			<activation>
				<property>
					<name>BUILD_SIGN</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.eclipse.cbi.maven.plugins</groupId>
						<artifactId>eclipse-macsigner-plugin</artifactId>
						<version>${cbi-version}</version>
						<executions>
							<execution>
								<id>sign-macos-products</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<signFiles>
								<signFile>${project.build.directory}/products/org.polarsys.capella.studio.releng.product/macosx/cocoa/x86_64/Capella-Studio.app</signFile>
								<signFile>${project.build.directory}/products/org.polarsys.capella.studio.releng.product/macosx/cocoa/aarch64/Capella-Studio.app</signFile>
							</signFiles>
							<entitlements>${project.basedir}/application.entitlements</entitlements>
							<timeoutMillis>900000</timeoutMillis>
							<continueOnFail>false</continueOnFail>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.eclipse.cbi.maven.plugins</groupId>
						<artifactId>eclipse-dmg-packager</artifactId>
						<version>${cbi-version}</version>
						<executions>
							<execution>
								<id>package-macos-x86_64-dmg</id>
								<phase>post-integration-test</phase>
								<goals>
									<goal>package-dmg</goal>
								</goals>
								<configuration>
									<source>${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.x86_64.tar.gz</source>
									<target>${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.x86_64.dmg</target>
								</configuration>
							</execution>
							<execution>
								<id>package-macos-aarch64-dmg</id>
								<phase>post-integration-test</phase>
								<goals>
									<goal>package-dmg</goal>
								</goals>
								<configuration>
									<source>${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.aarch64.tar.gz</source>
									<target>${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.aarch64.dmg</target>
								</configuration>
							</execution>
						</executions>
						<configuration>
							<sign>true</sign>
							<volumeName>Capella Studio</volumeName>
							<timeoutMillis>900000</timeoutMillis>
							<continueOnFail>false</continueOnFail>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<id>prepare-macos-dmg</id>
								<phase>integration-test</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<!-- A previous DMG must not hide a packaging-service failure. -->
										<delete file="${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.x86_64.dmg"/>
										<delete file="${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.aarch64.dmg"/>
									</target>
								</configuration>
							</execution>
							<execution>
								<id>verify-macos-dmgs</id>
								<phase>verify</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<!-- The CBI DMG plugin can return normally after an HTTP failure. -->
										<fail message="Missing or empty x86_64 DMG. Check the eclipse-dmg-packager output and target/products/*-CreateDMGMojo.log.">
											<condition>
												<not>
													<and>
														<available file="${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.x86_64.dmg" type="file"/>
														<length file="${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.x86_64.dmg" length="0" when="greater"/>
													</and>
												</not>
											</condition>
										</fail>
										<fail message="Missing or empty aarch64 DMG. Check the eclipse-dmg-packager output and target/products/*-CreateDMGMojo.log.">
											<condition>
												<not>
													<and>
														<available file="${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.aarch64.dmg" type="file"/>
														<length file="${project.build.directory}/products/capella-studio-${calversion}.${buildQualifier}-macosx.cocoa.aarch64.dmg" length="0" when="greater"/>
													</and>
												</not>
											</condition>
										</fail>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
